node_modules/
test-results/
playwright-report/
.playwright/
tmp/

# Distributable theme/plugin build output (transient ZIP artifacts)
products/wordpress/_dist/

docs/**/*-qa.png
docs/**/qa-*.png

*.tmp
.DS_Store
Thumbs.db

.vscode/
.idea/

# Transient demo Site Logo staging dir (seed.ps1 -SetDemoLogo)
.seed-tmp/

# Python bytecode from the validator scripts.
__pycache__/
*.pyc

# Local wp-env overrides. This is where a developer's own secrets go -- push signing keys, anything
# else a deployment would hold -- so it must never be committed. The tracked .wp-env.json stays free
# of them, which is the whole point of the split.
.wp-env.override.json
.svn-deploy-*/

# Jekyll build output for products/styleguide (CI artifact, never committed)
products/styleguide/_site/
products/styleguide/.jekyll-cache/
products/styleguide/.jekyll-metadata
products/styleguide/Gemfile.lock
products/styleguide/vendor/

# Synced from the products by tools/generators/sync_styleguide_assets.py
products/styleguide/assets/fonts/
products/styleguide/assets/css/fonts.css
products/styleguide/assets/css/product/
