{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Axismundi Client Development",
  "mainBinaryName": "axismundi-client-development",
  "version": "0.1.0",
  "identifier": "org.axismundi.client.development",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Axismundi Client 0.1.0 - Development",
        "width": 800,
        "height": 600
      }
    ]
  },
  "bundle": {
    "targets": ["nsis"],
    "useLocalToolsDir": true,
    "createUpdaterArtifacts": false,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
