{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "axismundi/actor-feed-loop",
	"version": "0.0.36",
	"title": "Actor Feed Loop",
	"category": "theme",
	"icon": "list-view",
	"description": "Displays the current Actor's public timeline of Activities and observed Objects.",
	"attributes": {
		"navigation": { "type": "string", "default": "" }
	},
	"textdomain": "axismundi-activities",
	"supports": {
		"html": false,
		"inserter": false,
		"align": [
			"wide",
			"full"
		],
		"spacing": {
			"margin": true,
			"padding": true
		},
		"interactivity": true
	},
	"style": "file:./style.css",
	"editorScript": "file:./edit.js",
	"render": "file:./render.php",
	"viewScriptModule": "file:./view.js"
}
