{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "axismundi/feed-loop",
	"version": "0.1.0",
	"title": "Feed Loop",
	"category": "theme",
	"icon": "layout",
	"description": "Repeats the feed's entries. It holds one item template per density; the first is the default, and a second adds the Card/Compact switch.",
	"textdomain": "axismundi-activities",
	"parent": [ "axismundi/feed-tab" ],
	"allowedBlocks": [ "axismundi/feed-item-template" ],
	"supports": {
		"html": false,
		"reusable": false,
		"inserter": false,
		"interactivity": { "clientNavigation": true }
	},
	"editorScript": "file:./edit.js",
	"render": "file:./render.php"
}
