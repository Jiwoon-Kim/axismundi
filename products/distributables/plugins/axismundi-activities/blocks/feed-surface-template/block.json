{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "axismundi/feed-surface-template",
	"version": "0.1.0",
	"title": "Feed Surface Template",
	"category": "theme",
	"icon": "layout",
	"description": "The layout one feed surface is read through, including how it is paged.",
	"textdomain": "axismundi-activities",
	"parent": [ "axismundi/feed-surface-templates" ],
	"attributes": {
		"surface": { "type": "string", "default": "default" },
		"navigation": { "type": "string", "default": "" }
	},
	"supports": { "html": false, "reusable": false, "inserter": false, "interactivity": { "clientNavigation": true } },
	"editorScript": "file:./edit.js",
	"render": "file:./render.php"
}
