{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "axismundi/feed",
	"version": "0.0.37",
	"title": "Feed",
	"category": "theme",
	"icon": "list-view",
	"description": "The Actor feed: it resolves which surface is being read, how it is walked, and hands that to the layouts inside it.",
	"textdomain": "axismundi-activities",
	"supports": {
		"html": false,
		"inserter": false,
		"align": [
			"wide",
			"full"
		],
		"spacing": {
			"margin": true,
			"padding": true
		},
		"interactivity": true
	},
	"style": "file:./style.css",
	"editorScript": "file:./edit.js",
	"render": "file:./render.php",
	"viewScriptModule": "file:./view.js"
}
