{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "axismundi/interaction",
	"version": "0.0.2",
	"title": "Interaction",
	"category": "widgets",
	"icon": "heart",
	"description": "One control for acting on the current projected object: reply, like, announce, quote, react or vote.",
	"textdomain": "axismundi-activities",
	"attributes": {
		"type": {
			"type": "string",
			"default": "like"
		},
		"objectUri": {
			"type": "string",
			"default": ""
		},
		"size": {
			"type": "string",
			"default": "sm"
		},
		"showLabel": {
			"type": "boolean",
			"default": false
		},
		"showCount": {
			"type": "boolean",
			"default": true
		},
		"announceMenu": {
			"type": "boolean",
			"default": false
		}
	},
	"usesContext": [
		"postId",
		"postType"
	],
	"supports": {
		"html": false,
		"anchor": true,
		"interactivity": true,
		"spacing": {
			"margin": true,
			"padding": false
		}
	},
	"editorScript": "file:./edit.js",
	"style": "file:./style.css",
	"editorStyle": "file:./style.css",
	"render": "file:./render.php"
}
