{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "axismundi/reaction-button",
	"version": "0.1.0",
	"title": "Reaction Button",
	"category": "widgets",
	"icon": "smiley",
	"description": "Opens an emoji picker for reacting to the current Object. Belongs among the other actions; the Reaction Bar block shows the reactions themselves.",
	"textdomain": "axismundi-activities",
	"attributes": {
		"objectUri": { "type": "string", "default": "" }
	},
	"usesContext": [ "postId", "postType" ],
	"supports": {
		"html": false,
		"anchor": true,
		"interactivity": true,
		"color": {
			"text": true,
			"background": true,
			"__experimentalDefaultControls": { "text": true }
		},
		"spacing": { "margin": true, "padding": true },
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalDefaultControls": { "fontSize": true }
		},
		"__experimentalBorder": { "radius": true, "color": true, "width": true, "style": true }
	},
	"editorScript": "file:./edit.js",
	"style": "axismundi-activities-reactions",
	"editorStyle": "axismundi-activities-reactions",
	"render": "file:./render.php"
}
