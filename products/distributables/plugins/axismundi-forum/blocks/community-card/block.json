{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "axismundi/community-card",
	"version": "0.1.0",
	"title": "Community Card",
	"category": "theme",
	"icon": "groups",
	"description": "The community a Topic belongs to, with its Group Actor identity and Follow control.",
	"textdomain": "axismundi-forum",
	"attributes": {
		"showMemberCount": { "type": "boolean", "default": true }
	},
	"example": { "viewportWidth": 320 },
	"supports": {
		"anchor": true,
		"html": false,
		"color": { "text": true, "background": true, "link": true },
		"spacing": { "margin": true, "padding": true, "blockGap": true },
		"typography": { "fontSize": true, "lineHeight": true },
		"__experimentalBorder": { "radius": true, "color": true, "width": true, "style": true }
	},
	"editorScript": "file:./edit.js",
	"render": "file:./render.php"
}
