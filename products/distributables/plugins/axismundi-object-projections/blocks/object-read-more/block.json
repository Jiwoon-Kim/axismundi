{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "axismundi/object-read-more",
	"version": "0.1.0",
	"title": "Object Read More",
	"category": "theme",
	"icon": "arrow-right-alt",
	"description": "A link into the full representation of the ActivityStreams Object being rendered. The words are yours to write, the destination is the Object's.",
	"textdomain": "axismundi-object-projections",
	"attributes": {
		"text": { "type": "string", "role": "content" },
		"textAlign": { "type": "string" }
	},
	"example": { "viewportWidth": 500 },
	"supports": {
		"anchor": true,
		"html": false,
		"align": [ "wide", "full" ],
		"color": {
			"gradients": true,
			"link": true,
			"__experimentalDefaultControls": { "background": true, "text": true, "link": true }
		},
		"spacing": { "margin": true, "padding": true },
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalFontFamily": true,
			"__experimentalFontWeight": true,
			"__experimentalFontStyle": true,
			"__experimentalTextTransform": true,
			"__experimentalTextDecoration": true,
			"__experimentalLetterSpacing": true,
			"__experimentalDefaultControls": { "fontSize": true }
		},
		"interactivity": { "clientNavigation": true },
		"__experimentalBorder": {
			"radius": true,
			"color": true,
			"width": true,
			"style": true
		}
	},
	"editorScript": "file:./edit.js",
	"render": "file:./render.php"
}
