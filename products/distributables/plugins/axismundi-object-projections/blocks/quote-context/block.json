{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "axismundi/quote-context",
	"version": "0.1.0",
	"title": "Quote Context",
	"category": "theme",
	"icon": "format-quote",
	"description": "A consent-aware embedded preview of the Object quoted by the current Object.",
	"textdomain": "axismundi-object-projections",
	"attributes": {
		"previewVariant": {
			"type": "string",
			"default": "note"
		}
	},
	"example": {
		"attributes": {
			"previewVariant": "note"
		},
		"viewportWidth": 420
	},
	"supports": {
		"anchor": true,
		"html": false,
		"color": {
			"text": true,
			"background": true,
			"link": true,
			"gradients": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalFontFamily": true,
			"__experimentalFontWeight": true,
			"__experimentalFontStyle": true,
			"__experimentalTextTransform": true,
			"__experimentalTextDecoration": true,
			"__experimentalLetterSpacing": true
		},
		"__experimentalBorder": {
			"radius": true,
			"color": true,
			"width": true,
			"style": true
		}
	},
	"editorScript": "file:./edit.js",
	"style": "axismundi-op-object-view",
	"editorStyle": "axismundi-op-object-view",
	"render": "file:./render.php"
}
