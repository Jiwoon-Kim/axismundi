{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "axismundi/actor-follow-list",
  "version": "0.1.0",
  "title": "Actor Follow List",
  "category": "theme",
  "icon": "groups",
  "description": "Displays the followers or following Actors for the current profile.",
  "textdomain": "axismundi-actors",
  "usesContext": ["axismundi/actorId"],
  "attributes": { "collection": { "type": "string", "default": "followers" } },
  "supports": { "html": false, "spacing": { "margin": true } },
  "editorScript": "file:./edit.js",
  "style": "file:./style.css",
  "render": "file:./render.php"
}
