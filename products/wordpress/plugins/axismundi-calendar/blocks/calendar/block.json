{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "axismundi-calendar/calendar",
	"title": "Calendar",
	"category": "widgets",
	"icon": "calendar-alt",
	"description": "A month or week view of this site's Events.",
	"textdomain": "axismundi-calendar",
	"attributes": {
		"view": {
			"type": "string",
			"default": "month",
			"enum": [ "month", "week" ]
		},
		"calendar": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"spacing": { "margin": true, "padding": true },
		"color": { "background": true, "text": true },
		"typography": { "fontSize": true }
	},
	"editorScript": "file:./edit.js",
	"style": "axismundi-calendar-grid",
	"render": "file:./render.php"
}
