{
	"apiVersion": 3,
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"name": "axismundi/dialog-icon",
	"title": "Dialog Icon",
	"category": "media",
	"description": "An icon from the theme's icon font or the WordPress Icon Registry. Also the leading icon of a basic dialog header.",
	"keywords": [ "icon", "svg", "dialog" ],
	"textdomain": "axismundi-dialogs",
	"attributes": {
		"icon": {
			"type": "string",
			"role": "content"
		},
		"flipHorizontal": {
			"type": "boolean",
			"default": false
		},
		"flipVertical": {
			"type": "boolean",
			"default": false
		},
		"rotation": {
			"type": "number",
			"default": 0
		},
		"iconSource": {
			"type": "string",
			"enum": [ "font", "registry" ]
		},
		"iconClass": {
			"type": "string",
			"default": "material-symbols-outlined"
		},
		"tagName": {
			"type": "string",
			"enum": [ "span", "div" ],
			"default": "span"
		}
	},
	"supports": {
		"anchor": true,
		"ariaLabel": {
			"__experimentalSkipSerialization": true
		},
		"align": [ "left", "center", "right" ],
		"html": false,
		"color": {
			"__experimentalSkipSerialization": true,
			"__experimentalDefaultControls": {
				"background": true,
				"text": true
			}
		},
		"typography": {
			"fontSize": true,
			"__experimentalSkipSerialization": [ "fontSize" ]
		},
		"interactivity": {
			"clientNavigation": true
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true,
			"__experimentalSkipSerialization": true,
			"__experimentalDefaultControls": {
				"color": false,
				"radius": false,
				"style": false,
				"width": false
			}
		},
		"spacing": {
			"padding": true,
			"margin": true,
			"__experimentalSkipSerialization": [ "padding" ],
			"__experimentalDefaultControls": {
				"margin": false,
				"padding": false
			}
		},
		"dimensions": {
			"width": true,
			"__experimentalSkipSerialization": [ "width" ],
			"__experimentalDefaultControls": {
				"width": true
			}
		}
	},
	"selectors": {
		"root": ".wp-block-axismundi-dialog-icon svg",
		"css": ".wp-block-axismundi-dialog-icon",
		"spacing": {
			"margin": ".wp-block-axismundi-dialog-icon"
		}
	},
	"editorScript": "file:./edit.js",
	"style": "axismundi-dialog-icon",
	"editorStyle": "axismundi-dialog-icon-editor",
	"render": "file:./render.php"
}
