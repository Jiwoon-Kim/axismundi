{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "axismundi/dialog",
	"title": "Dialog",
	"category": "theme",
	"description": "The HTML dialog at the root of a Dialog Surface template part. Choose how it presents - a basic or full-screen dialog, a bottom or side sheet - and build its content inside.",
	"keywords": [ "dialog", "sheet", "modal", "drawer", "surface" ],
	"textdomain": "axismundi-dialogs",
	"attributes": {
		"presentation": {
			"type": "string",
			"enum": [ "dialog-basic", "dialog-full-screen", "sheet-bottom", "sheet-side" ],
			"default": "dialog-basic"
		},
		"modality": {
			"type": "string",
			"enum": [ "modal", "standard" ],
			"default": "modal"
		},
		"attachment": {
			"type": "string",
			"enum": [ "docked", "detached" ],
			"default": "docked"
		},
		"edge": {
			"type": "string",
			"enum": [ "start", "end" ],
			"default": "end"
		},
		"dismissal": {
			"type": "string",
			"enum": [ "any", "closerequest", "none" ],
			"default": "any"
		},
		"label": {
			"type": "string"
		}
	},
	"supports": {
		"html": false,
		"reusable": false
	},
	"editorScript": "file:./edit.js",
	"editorStyle": "file:./editor.css",
	"style": "file:./style.css",
	"render": "file:./render.php"
}
