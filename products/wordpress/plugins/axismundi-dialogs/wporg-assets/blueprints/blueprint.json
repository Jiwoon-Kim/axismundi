{
    "$schema": "https://playground.wordpress.net/blueprint-schema.json",
    "landingPage": "/dialogs-vqa/",
    "preferredVersions": {
        "php": "8.3",
        "wp": "latest"
    },
    "steps": [
        {
            "step": "login",
            "username": "admin",
            "password": "password"
        },
        {
            "step": "installTheme",
            "themeData": {
                "resource": "wordpress.org/themes",
                "slug": "axismundi"
            },
            "options": {
                "activate": true
            }
        },
        {
            "step": "installPlugin",
            "pluginData": {
                "resource": "wordpress.org/plugins",
                "slug": "axismundi-dialogs"
            },
            "options": {
                "activate": true
            }
        },
        {
            "step": "installPlugin",
            "pluginData": {
                "resource": "wordpress.org/plugins",
                "slug": "axismundi-theme-switcher"
            },
            "options": {
                "activate": true,
                "onError": "skip-plugin"
            }
        },
        {
            "step": "runPHP",
            "code": "<?php\n/**\n * Live Preview setup: the Dialog Surface parts and the VQA page.\n *\n * Source for blueprint.json. build.py puts vqa-page.html where the marker line\n * below is and embeds this file as the runPHP step's code, because a runPHP\n * step takes inline code only.\n *\n * @package AxismundiDialogs\n */\n\nrequire_once '/wordpress/wp-load.php';\n\n/*\n * Each part starts from one of the plugin's own starter patterns, so the\n * preview also proves the patterns work as real parts; a few change only the\n * root Dialog block's settings.\n */\nfunction axismundi_vqa_pattern( $name ) {\n\t$pattern = WP_Block_Patterns_Registry::get_instance()->get_registered( 'axismundi-dialogs/dialog-surface-' . $name );\n\treturn $pattern ? $pattern['content'] : '';\n}\n\nfunction axismundi_vqa_with_root_attrs( $content, $attrs ) {\n\t$blocks = parse_blocks( $content );\n\tforeach ( $blocks as $i => $block ) {\n\t\tif ( 'axismundi/dialog' === $block['blockName'] ) {\n\t\t\t$blocks[ $i ]['attrs'] = array_merge( (array) $block['attrs'], $attrs );\n\t\t\tbreak;\n\t\t}\n\t}\n\treturn serialize_blocks( $blocks );\n}\n\n$parts = array(\n\t'dialog-basic'              => array( 'Dialog - Basic', 'basic', array() ),\n\t'dialog-basic-icon'         => array( 'Dialog - Basic with icon', 'basic-icon', array() ),\n\t'dialog-list'               => array( 'Dialog - List', 'list', array() ),\n\t'dialog-dismiss-none'       => array( 'Dialog - Basic, no light dismiss', 'basic', array( 'dismissal' => 'none' ) ),\n\t'dialog-full-screen'        => array( 'Dialog - Full screen', 'full-screen', array() ),\n\t'sheets-bottom'             => array( 'Sheets - Bottom', 'bottom-sheet', array() ),\n\t'sheets-side'               => array( 'Sheets - Side', 'side-sheet-modal', array() ),\n\t'sheets-side-start'         => array( 'Sheets - Side, start edge', 'side-sheet-modal', array( 'edge' => 'start' ) ),\n\t'sheets-side-standard'      => array( 'Sheets - Side, standard (resize)', 'side-sheet-standard', array() ),\n\t'sheets-side-standard-move' => array( 'Sheets - Side, standard (move)', 'side-sheet-standard', array( 'pageShare' => 'move' ) ),\n);\n\nforeach ( $parts as $slug => list( $title, $pattern, $attrs ) ) {\n\t$content = axismundi_vqa_pattern( $pattern );\n\tif ( '' === $content ) {\n\t\tcontinue;\n\t}\n\tif ( $attrs ) {\n\t\t$content = axismundi_vqa_with_root_attrs( $content, $attrs );\n\t}\n\t$id = wp_insert_post(\n\t\tarray(\n\t\t\t'post_type'    => 'wp_template_part',\n\t\t\t'post_status'  => 'publish',\n\t\t\t'post_name'    => $slug,\n\t\t\t'post_title'   => $title,\n\t\t\t'post_content' => $content,\n\t\t)\n\t);\n\tif ( $id && ! is_wp_error( $id ) ) {\n\t\twp_set_object_terms( $id, get_stylesheet(), 'wp_theme' );\n\t\twp_set_object_terms( $id, 'dialog-surface', 'wp_template_part_area' );\n\t}\n}\n\n$content = <<<'HTML'\n<!-- wp:paragraph -->\n<p>Every control on this page is a real block with its saved settings. Open the surfaces, press the toggles, hover the icons, and switch the colour scheme at the bottom.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Dialogs and sheets</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Each button opens a Dialog Surface template part. The part renders once at the end of the page, however many buttons open it.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:axismundi/dialog-button-group {\"size\":\"small\",\"shape\":\"round\"} -->\n<div class=\"wp-block-axismundi-dialog-button-group wp-block-buttons\" data-size=\"small\" data-shape=\"round\"><!-- wp:axismundi/dialog-button {\"action\":\"dialog-surface\",\"actionTarget\":\"dialog-basic\",\"text\":\"Dialog - Basic\"} /-->\n\n<!-- wp:axismundi/dialog-button {\"action\":\"dialog-surface\",\"actionTarget\":\"dialog-full-screen\",\"text\":\"Dialog - Full screen\"} /-->\n\n<!-- wp:axismundi/dialog-button {\"action\":\"dialog-surface\",\"actionTarget\":\"sheets-side\",\"text\":\"Sheets - Side\"} /-->\n\n<!-- wp:axismundi/dialog-button {\"action\":\"dialog-surface\",\"actionTarget\":\"sheets-bottom\",\"text\":\"Sheets - Bottom\"} /--></div>\n<!-- /wp:axismundi/dialog-button-group -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Dialog layouts</h3>\n<!-- /wp:heading -->\n\n<!-- wp:axismundi/dialog-button-group {\"size\":\"small\",\"shape\":\"round\"} -->\n<div class=\"wp-block-axismundi-dialog-button-group wp-block-buttons\" data-size=\"small\" data-shape=\"round\"><!-- wp:axismundi/dialog-button {\"action\":\"dialog-surface\",\"actionTarget\":\"dialog-basic-icon\",\"text\":\"With icon\",\"className\":\"is-style-tonal\"} /-->\n\n<!-- wp:axismundi/dialog-button {\"action\":\"dialog-surface\",\"actionTarget\":\"dialog-list\",\"text\":\"List\",\"className\":\"is-style-tonal\"} /-->\n\n<!-- wp:axismundi/dialog-button {\"action\":\"dialog-surface\",\"actionTarget\":\"dialog-dismiss-none\",\"text\":\"No light dismiss\",\"className\":\"is-style-tonal\"} /--></div>\n<!-- /wp:axismundi/dialog-button-group -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Side sheets</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>A standard side sheet stays open beside the page and resizes or moves it. Below 600 pixels it opens as a modal.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:axismundi/dialog-button-group {\"size\":\"small\",\"shape\":\"round\"} -->\n<div class=\"wp-block-axismundi-dialog-button-group wp-block-buttons\" data-size=\"small\" data-shape=\"round\"><!-- wp:axismundi/dialog-button {\"action\":\"dialog-surface\",\"actionTarget\":\"sheets-side-start\",\"text\":\"Modal, start edge\",\"className\":\"is-style-outlined\"} /-->\n\n<!-- wp:axismundi/dialog-button {\"action\":\"dialog-surface\",\"actionTarget\":\"sheets-side-standard\",\"text\":\"Standard, resize\",\"className\":\"is-style-outlined\"} /-->\n\n<!-- wp:axismundi/dialog-button {\"action\":\"dialog-surface\",\"actionTarget\":\"sheets-side-standard-move\",\"text\":\"Standard, move\",\"className\":\"is-style-outlined\"} /--></div>\n<!-- /wp:axismundi/dialog-button-group -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">One part, three triggers</h3>\n<!-- /wp:heading -->\n\n<!-- wp:axismundi/dialog-button-group {\"size\":\"small\",\"shape\":\"round\",\"buttonType\":\"icon\"} -->\n<div class=\"wp-block-axismundi-dialog-button-group wp-block-buttons\" data-size=\"small\" data-shape=\"round\"><!-- wp:axismundi/dialog-icon-button {\"action\":\"dialog-surface\",\"actionTarget\":\"sheets-bottom\",\"text\":\"Open bottom sheet\",\"icon\":\"expand_less\",\"selectedIcon\":\"expand_more\",\"iconTransition\":\"fade\"} /-->\n\n<!-- wp:axismundi/dialog-icon-button {\"action\":\"dialog-surface\",\"actionTarget\":\"sheets-bottom\",\"text\":\"Open bottom sheet again\",\"icon\":\"add\",\"iconTransition\":\"rotate\",\"selectedRotation\":45,\"className\":\"is-style-tonal\"} /-->\n\n<!-- wp:axismundi/dialog-icon-button {\"action\":\"dialog-surface\",\"actionTarget\":\"sheets-bottom\",\"text\":\"Share\",\"icon\":\"share\",\"className\":\"is-style-standard\"} /--></div>\n<!-- /wp:axismundi/dialog-button-group -->\n\n<!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Navigation overlay</h2>\n<!-- /wp:heading -->\n\n<!-- wp:axismundi/dialog-button-group {\"size\":\"small\",\"shape\":\"round\",\"buttonType\":\"icon\"} -->\n<div class=\"wp-block-axismundi-dialog-button-group wp-block-buttons\" data-size=\"small\" data-shape=\"round\"><!-- wp:axismundi/dialog-icon-button {\"action\":\"overlay\",\"actionTarget\":\"navigation-overlay\",\"text\":\"Open menu\",\"icon\":\"menu\",\"className\":\"is-style-standard\"} /--></div>\n<!-- /wp:axismundi/dialog-button-group -->\n\n<!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Icons</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Core Icon beside Dialog Icon from the Icon Registry and from the icon font, with the font's Fill axis at 0 and 1.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"nowrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:icon {\"icon\":\"core/info\",\"align\":\"center\"} /-->\n\n<!-- wp:axismundi/dialog-icon {\"icon\":\"core/file\",\"iconSource\":\"registry\",\"align\":\"center\",\"style\":{\"typography\":{\"fontVariationSettings\":[{\"FILL\":\"0\"},{\"wght\":\"400\"},{\"GRAD\":\"0\"},{\"opsz\":\"24\"}]}}} /-->\n\n<!-- wp:axismundi/dialog-icon {\"icon\":\"delete\",\"iconSource\":\"font\",\"style\":{\"typography\":{\"fontVariationSettings\":[{\"FILL\":\"0\"},{\"wght\":\"400\"},{\"GRAD\":\"0\"},{\"opsz\":\"24\"}]}}} /-->\n\n<!-- wp:axismundi/dialog-icon {\"icon\":\"favorite\",\"iconSource\":\"font\",\"style\":{\"typography\":{\"fontVariationSettings\":[{\"FILL\":\"0\"},{\"wght\":\"400\"},{\"GRAD\":\"0\"},{\"opsz\":\"24\"}]}}} /-->\n\n<!-- wp:axismundi/dialog-icon {\"icon\":\"favorite\",\"iconSource\":\"font\",\"style\":{\"typography\":{\"fontVariationSettings\":[{\"FILL\":\"1\"},{\"wght\":\"400\"},{\"GRAD\":\"0\"},{\"opsz\":\"24\"}]},\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|error\"}}}},\"textColor\":\"error\"} /--></div>\n<!-- /wp:group -->\n\n<!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Buttons</h2>\n<!-- /wp:heading -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Colour styles</h3>\n<!-- /wp:heading -->\n\n<!-- wp:axismundi/dialog-button-group {\"size\":\"small\",\"shape\":\"round\"} -->\n<div class=\"wp-block-axismundi-dialog-button-group wp-block-buttons\" data-size=\"small\" data-shape=\"round\"><!-- wp:axismundi/dialog-button {\"text\":\"Filled\",\"showIcon\":true,\"icon\":\"info\"} /-->\n\n<!-- wp:axismundi/dialog-button {\"text\":\"Tonal\",\"className\":\"is-style-tonal\"} /-->\n\n<!-- wp:axismundi/dialog-button {\"text\":\"Outlined\",\"className\":\"is-style-outlined\"} /-->\n\n<!-- wp:axismundi/dialog-button {\"text\":\"Elevated\",\"className\":\"is-style-elevated\"} /-->\n\n<!-- wp:axismundi/dialog-button {\"text\":\"Text\",\"className\":\"is-style-text\"} /--></div>\n<!-- /wp:axismundi/dialog-button-group -->\n\n<!-- wp:axismundi/dialog-button-group {\"size\":\"small\",\"shape\":\"round\",\"buttonType\":\"icon\"} -->\n<div class=\"wp-block-axismundi-dialog-button-group wp-block-buttons\" data-size=\"small\" data-shape=\"round\"><!-- wp:axismundi/dialog-icon-button {\"text\":\"Filled\",\"icon\":\"stars\"} /-->\n\n<!-- wp:axismundi/dialog-icon-button {\"text\":\"Tonal\",\"icon\":\"stars\",\"className\":\"is-style-tonal\"} /-->\n\n<!-- wp:axismundi/dialog-icon-button {\"text\":\"Outlined\",\"icon\":\"stars\",\"className\":\"is-style-outlined\"} /-->\n\n<!-- wp:axismundi/dialog-icon-button {\"text\":\"Standard\",\"icon\":\"stars\",\"className\":\"is-style-standard\"} /--></div>\n<!-- /wp:axismundi/dialog-button-group -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Sizes and widths</h3>\n<!-- /wp:heading -->\n\n<!-- wp:axismundi/dialog-button-group {\"size\":\"small\",\"shape\":\"round\"} -->\n<div class=\"wp-block-axismundi-dialog-button-group wp-block-buttons\" data-size=\"small\" data-shape=\"round\"><!-- wp:axismundi/dialog-button {\"size\":\"xsmall\",\"text\":\"XSmall\",\"showIcon\":true,\"icon\":\"edit\"} /-->\n\n<!-- wp:axismundi/dialog-button {\"size\":\"small\",\"text\":\"Small\",\"showIcon\":true,\"icon\":\"edit\"} /-->\n\n<!-- wp:axismundi/dialog-button {\"size\":\"medium\",\"text\":\"Medium\",\"showIcon\":true,\"icon\":\"edit\"} /-->\n\n<!-- wp:axismundi/dialog-button {\"size\":\"large\",\"text\":\"Large\",\"showIcon\":true,\"icon\":\"edit\"} /-->\n\n<!-- wp:axismundi/dialog-button {\"size\":\"xlarge\",\"text\":\"XLarge\",\"showIcon\":true,\"icon\":\"edit\"} /--></div>\n<!-- /wp:axismundi/dialog-button-group -->\n\n<!-- wp:axismundi/dialog-button-group {\"size\":\"small\",\"shape\":\"round\",\"buttonType\":\"icon\",\"layout\":{\"type\":\"flex\",\"justifyContent\":\"center\"}} -->\n<div class=\"wp-block-axismundi-dialog-button-group wp-block-buttons\" data-size=\"small\" data-shape=\"round\"><!-- wp:axismundi/dialog-icon-button {\"size\":\"xsmall\",\"text\":\"XSmall\",\"icon\":\"play_arrow\"} /-->\n\n<!-- wp:axismundi/dialog-icon-button {\"size\":\"small\",\"text\":\"Small\",\"icon\":\"play_arrow\"} /-->\n\n<!-- wp:axismundi/dialog-icon-button {\"size\":\"medium\",\"text\":\"Medium\",\"icon\":\"play_arrow\"} /-->\n\n<!-- wp:axismundi/dialog-icon-button {\"size\":\"large\",\"text\":\"Large\",\"icon\":\"play_arrow\"} /-->\n\n<!-- wp:axismundi/dialog-icon-button {\"size\":\"xlarge\",\"text\":\"XLarge\",\"icon\":\"play_arrow\"} /--></div>\n<!-- /wp:axismundi/dialog-button-group -->\n\n<!-- wp:axismundi/dialog-button-group {\"size\":\"small\",\"shape\":\"round\",\"buttonType\":\"icon\"} -->\n<div class=\"wp-block-axismundi-dialog-button-group wp-block-buttons\" data-size=\"small\" data-shape=\"round\"><!-- wp:axismundi/dialog-icon-button {\"width\":\"narrow\",\"text\":\"More, narrow\",\"icon\":\"more_vert\"} /-->\n\n<!-- wp:axismundi/dialog-icon-button {\"text\":\"More\",\"icon\":\"more_vert\"} /-->\n\n<!-- wp:axismundi/dialog-icon-button {\"width\":\"wide\",\"text\":\"More, wide\",\"icon\":\"more_vert\"} /--></div>\n<!-- /wp:axismundi/dialog-button-group -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Selection</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Single choice, single choice that cannot be empty, and several at once. Disabled buttons sit in the first group.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:axismundi/dialog-button-group {\"size\":\"small\",\"shape\":\"round\",\"togglable\":true,\"selection\":\"single\"} -->\n<div class=\"wp-block-axismundi-dialog-button-group wp-block-buttons\" data-size=\"small\" data-shape=\"round\"><!-- wp:axismundi/dialog-button {\"text\":\"Filled\",\"showIcon\":true,\"icon\":\"stars\"} /-->\n\n<!-- wp:axismundi/dialog-button {\"text\":\"Tonal\",\"showIcon\":true,\"icon\":\"stars\",\"className\":\"is-style-tonal\"} /-->\n\n<!-- wp:axismundi/dialog-button {\"text\":\"Outlined\",\"showIcon\":true,\"icon\":\"stars\",\"className\":\"is-style-outlined\"} /-->\n\n<!-- wp:axismundi/dialog-icon-button {\"text\":\"Filled icon\",\"icon\":\"stars\",\"className\":\"is-style-fill\"} /-->\n\n<!-- wp:axismundi/dialog-icon-button {\"text\":\"Standard icon\",\"icon\":\"stars\",\"className\":\"is-style-standard\"} /-->\n\n<!-- wp:axismundi/dialog-button {\"disabled\":true,\"text\":\"Disabled\"} /-->\n\n<!-- wp:axismundi/dialog-icon-button {\"disabled\":true,\"text\":\"Disabled icon\",\"icon\":\"stars\"} /--></div>\n<!-- /wp:axismundi/dialog-button-group -->\n\n<!-- wp:axismundi/dialog-button-group {\"size\":\"small\",\"distribution\":\"fill\",\"togglable\":true,\"selection\":\"single\",\"selectionRequired\":true} -->\n<div class=\"wp-block-axismundi-dialog-button-group wp-block-buttons\" data-size=\"small\" data-distribution=\"fill\"><!-- wp:axismundi/dialog-button {\"text\":\"Day\",\"selected\":true,\"className\":\"is-style-outlined\"} /-->\n\n<!-- wp:axismundi/dialog-button {\"text\":\"Week\",\"className\":\"is-style-outlined\"} /-->\n\n<!-- wp:axismundi/dialog-button {\"text\":\"Month\",\"className\":\"is-style-outlined\"} /--></div>\n<!-- /wp:axismundi/dialog-button-group -->\n\n<!-- wp:axismundi/dialog-button-group {\"size\":\"small\",\"shape\":\"round\",\"togglable\":true,\"selection\":\"multiple\"} -->\n<div class=\"wp-block-axismundi-dialog-button-group wp-block-buttons\" data-size=\"small\" data-shape=\"round\"><!-- wp:axismundi/dialog-button {\"text\":\"Bold\",\"showIcon\":true,\"icon\":\"format_bold\",\"className\":\"is-style-tonal\"} /-->\n\n<!-- wp:axismundi/dialog-button {\"text\":\"Italic\",\"showIcon\":true,\"icon\":\"format_italic\",\"className\":\"is-style-tonal\"} /-->\n\n<!-- wp:axismundi/dialog-button {\"text\":\"Underline\",\"showIcon\":true,\"icon\":\"format_underlined\",\"className\":\"is-style-tonal\"} /--></div>\n<!-- /wp:axismundi/dialog-button-group -->\n\n<!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Icon states</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Hover or focus to preview the selected state, then press to keep it: Like fills, Repost turns, Expand swaps to a second Icon Registry icon.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:axismundi/dialog-button-group {\"size\":\"small\",\"shape\":\"round\",\"buttonType\":\"icon\",\"togglable\":true} -->\n<div class=\"wp-block-axismundi-dialog-button-group wp-block-buttons\" data-size=\"small\" data-shape=\"round\"><!-- wp:axismundi/dialog-icon-button {\"text\":\"Like\",\"icon\":\"favorite\",\"iconPreviewOnHover\":true,\"className\":\"is-style-standard\"} /-->\n\n<!-- wp:axismundi/dialog-icon-button {\"text\":\"Repost\",\"icon\":\"sync\",\"iconTransition\":\"rotate\",\"fillOnSelect\":false,\"iconPreviewOnHover\":true,\"className\":\"is-style-standard\"} /-->\n\n<!-- wp:axismundi/dialog-icon-button {\"text\":\"React\",\"icon\":\"add_reaction\",\"fillOnSelect\":false,\"iconPreviewOnHover\":true} /-->\n\n<!-- wp:axismundi/dialog-icon-button {\"text\":\"Expand\",\"iconSource\":\"registry\",\"icon\":\"core/chevron-down\",\"selectedIcon\":\"core/chevron-up\",\"iconTransition\":\"fade\",\"iconPreviewOnHover\":true,\"className\":\"is-style-tonal\"} /--></div>\n<!-- /wp:axismundi/dialog-button-group -->\n\n<!-- wp:axismundi/dialog-button-group {\"size\":\"small\",\"shape\":\"round\",\"layout\":{\"type\":\"flex\",\"verticalAlignment\":\"center\",\"justifyContent\":\"center\"}} -->\n<div class=\"wp-block-axismundi-dialog-button-group wp-block-buttons\" data-size=\"small\" data-shape=\"round\"><!-- wp:axismundi/dialog-icon-button {\"size\":\"medium\",\"width\":\"wide\",\"text\":\"Previous\",\"icon\":\"skip_previous\",\"className\":\"is-style-outlined\"} /-->\n\n<!-- wp:axismundi/dialog-button {\"size\":\"large\",\"togglable\":true,\"text\":\"Play\",\"showIcon\":true,\"icon\":\"play_arrow\",\"selectedIcon\":\"pause\",\"iconTransition\":\"scale\",\"className\":\"is-style-tonal\"} /-->\n\n<!-- wp:axismundi/dialog-icon-button {\"size\":\"medium\",\"width\":\"wide\",\"text\":\"Next\",\"icon\":\"skip_next\",\"className\":\"is-style-outlined\"} /--></div>\n<!-- /wp:axismundi/dialog-button-group -->\n\n<!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Colour scheme</h2>\n<!-- /wp:heading -->\n\n<!-- wp:axismundi/theme-switcher {\"className\":\"is-style-filled\",\"layout\":{\"type\":\"flex\",\"justifyContent\":\"center\"}} /-->\n\n<!-- wp:axismundi/theme-switcher {\"showLabels\":false,\"className\":\"is-style-tonal\",\"layout\":{\"type\":\"flex\",\"justifyContent\":\"center\"}} /-->\nHTML;\n\n// The blueprint's landingPage opens this page by its slug.\nwp_insert_post(\n\tarray(\n\t\t'post_title'   => 'Plugin VQA - Axismundi Dialogs',\n\t\t'post_name'    => 'dialogs-vqa',\n\t\t'post_type'    => 'page',\n\t\t'post_status'  => 'publish',\n\t\t'post_content' => $content,\n\t)\n);\n"
        }
    ]
}
