{
    "$schema": "https://playground.wordpress.net/blueprint-schema.json",
    "landingPage": "/emoji-demo/",
    "preferredVersions": {
        "php": "8.3",
        "wp": "latest"
    },
    "steps": [
        {
            "step": "login",
            "username": "admin",
            "password": "password"
        },
        {
            "step": "installPlugin",
            "pluginData": {
                "resource": "url",
                "url": "https://github.com/Jiwoon-Kim/axismundi/releases/download/emoji-v0.3.0/axismundi-emoji.zip"
            },
            "options": {
                "activate": true
            }
        },
        {
            "step": "runPHP",
            "code": "<?php\n/**\n * Playground setup: the rendering demo page.\n *\n * Source for the blueprints. build.py puts demo-page.html where the marker line\n * below is and embeds this file as the runPHP step's code, because a runPHP\n * step takes inline code only.\n *\n * @package AxismundiEmoji\n */\n\nrequire_once '/wordpress/wp-load.php';\n\n// The page carries a status script; kses would strip it for a request with no user.\nwp_set_current_user( 1 );\nkses_remove_filters();\n\n$content = <<<'HTML'\n<!-- wp:paragraph -->\n<p>Each row below is plain Unicode text in the post. Once the page has loaded, the last column says what drew it: the browser's own emoji font, the Noto Color Emoji font bundled with Axismundi Emoji, or a WordPress.org image (WordPress's own fallback). Custom emoji are this site's images.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:html -->\n<style>\n.ax-emoji-demo { overflow-x: auto; }\n.ax-emoji-demo table { border-collapse: collapse; width: 100%; font-size: 0.9em; }\n.ax-emoji-demo th, .ax-emoji-demo td { border-bottom: 1px solid color-mix( in srgb, currentColor 20%, transparent ); padding: 0.5em 0.75em; text-align: start; vertical-align: middle; }\n.ax-emoji-demo__glyph { font-size: 2em; line-height: 1.2; white-space: nowrap; }\n.ax-emoji-demo__glyph img { width: 1em !important; height: 1em !important; }\n.ax-emoji-demo__by { font-weight: 600; }\n.ax-emoji-demo__status { padding: 0.75em 1em; border-radius: 8px; background: color-mix( in srgb, currentColor 8%, transparent ); }\n.ax-emoji-demo__status dl { display: grid; grid-template-columns: max-content 1fr; gap: 0.25em 1em; margin: 0; }\n.ax-emoji-demo__status dt { font-weight: 600; }\n.ax-emoji-demo__status dd { margin: 0; }\n</style>\n<div class=\"ax-emoji-demo\">\n<div class=\"ax-emoji-demo__status\" id=\"ax-emoji-demo-status\"><p>Checking this browser&hellip;</p></div>\n<table>\n<thead><tr><th>Sample</th><th>Case</th><th>Code points</th><th>Drawn by</th></tr></thead>\n<tbody>\n<tr><td class=\"ax-emoji-demo__glyph\">&#x1F600;</td><td>Basic emoji</td><td><code>1F600</code></td><td class=\"ax-emoji-demo__by\">&hellip;</td></tr>\n<tr><td class=\"ax-emoji-demo__glyph\">&#x1FAC8;</td><td>Emoji 17.0, one code point (the one WordPress tests)</td><td><code>1FAC8</code></td><td class=\"ax-emoji-demo__by\">&hellip;</td></tr>\n<tr><td class=\"ax-emoji-demo__glyph\">&#x1F9D1;&#x200D;&#x1FA70;</td><td>Emoji 17.0 ZWJ sequence</td><td><code>1F9D1 200D 1FA70</code></td><td class=\"ax-emoji-demo__by\">&hellip;</td></tr>\n<tr><td class=\"ax-emoji-demo__glyph\">&#x1F1F0;&#x1F1F7;</td><td>Country flag</td><td><code>1F1F0 1F1F7</code></td><td class=\"ax-emoji-demo__by\">&hellip;</td></tr>\n<tr><td class=\"ax-emoji-demo__glyph\">&#x1F1E8;&#x1F1F6;</td><td>Country flag, newer (Sark)</td><td><code>1F1E8 1F1F6</code></td><td class=\"ax-emoji-demo__by\">&hellip;</td></tr>\n<tr><td class=\"ax-emoji-demo__glyph\">&#x1F3F4;&#xE0067;&#xE0062;&#xE0065;&#xE006E;&#xE0067;&#xE007F;</td><td>Subdivision flag (England), a tag sequence</td><td><code>1F3F4 E0067 E0062 E0065 E006E E0067 E007F</code></td><td class=\"ax-emoji-demo__by\">&hellip;</td></tr>\n<tr><td class=\"ax-emoji-demo__glyph\">&#x1F3F3;&#xFE0F;&#x200D;&#x26A7;&#xFE0F;</td><td>ZWJ flag (transgender)</td><td><code>1F3F3 FE0F 200D 26A7 FE0F</code></td><td class=\"ax-emoji-demo__by\">&hellip;</td></tr>\n<tr><td class=\"ax-emoji-demo__glyph\">&#x1F3F4;&#x200D;&#x2620;&#xFE0F;</td><td>ZWJ flag (pirate)</td><td><code>1F3F4 200D 2620 FE0F</code></td><td class=\"ax-emoji-demo__by\">&hellip;</td></tr>\n<tr><td class=\"ax-emoji-demo__glyph\">&#x1F469;&#x1F3FD;&#x200D;&#x1F4BB;</td><td>Skin tone and ZWJ</td><td><code>1F469 1F3FD 200D 1F4BB</code></td><td class=\"ax-emoji-demo__by\">&hellip;</td></tr>\n<tr><td class=\"ax-emoji-demo__glyph\">&#x1F468;&#x200D;&#x1F469;&#x200D;&#x1F467;&#x200D;&#x1F466;</td><td>Family, three joiners</td><td><code>1F468 200D 1F469 200D 1F467 200D 1F466</code></td><td class=\"ax-emoji-demo__by\">&hellip;</td></tr>\n<tr><td class=\"ax-emoji-demo__glyph\">&#x2764;&#xFE0F;</td><td>Emoji presentation selector</td><td><code>2764 FE0F</code></td><td class=\"ax-emoji-demo__by\">&hellip;</td></tr>\n<tr><td class=\"ax-emoji-demo__glyph\">:wordpress: :axismundi:</td><td>Custom emoji bundled with the plugin</td><td><code>:wordpress: :axismundi:</code></td><td class=\"ax-emoji-demo__by\">&hellip;</td></tr>\n</tbody>\n</table>\n</div>\n<script>\n( function () {\n\tvar root = document.querySelector( '.ax-emoji-demo' );\n\tif ( ! root ) {\n\t\treturn;\n\t}\n\n\tfunction drawnBy( cell ) {\n\t\tif ( cell.querySelector( 'img.ax-emoji' ) ) {\n\t\t\treturn 'Custom emoji (this site’s image)';\n\t\t}\n\t\tif ( cell.querySelector( 'img.emoji' ) ) {\n\t\t\treturn 'WordPress.org image';\n\t\t}\n\t\tvar wrapper = cell.querySelector( '.ax-unicode-emoji' );\n\t\tif ( wrapper ) {\n\t\t\treturn 'Noto Color Emoji (' + wrapper.getAttribute( 'data-ax-emoji-profile' ) + ')';\n\t\t}\n\t\treturn 'Browser’s own font';\n\t}\n\n\tfunction coreSupports() {\n\t\ttry {\n\t\t\tvar stored = JSON.parse( sessionStorage.getItem( 'wpEmojiSettingsSupports' ) || 'null' );\n\t\t\tvar tests = stored && stored.supportTests;\n\t\t\tif ( ! tests ) {\n\t\t\t\treturn 'not run on this page';\n\t\t\t}\n\t\t\treturn Object.keys( tests ).map( function ( key ) {\n\t\t\t\treturn key + ': ' + ( tests[ key ] ? 'yes' : 'no' );\n\t\t\t} ).join( ', ' );\n\t\t} catch ( e ) {\n\t\t\treturn 'unavailable';\n\t\t}\n\t}\n\n\tfunction row( term, value ) {\n\t\tvar dt = document.createElement( 'dt' );\n\t\tvar dd = document.createElement( 'dd' );\n\t\tdt.textContent = term;\n\t\tdd.textContent = value;\n\t\treturn [ dt, dd ];\n\t}\n\n\tfunction render() {\n\t\troot.querySelectorAll( 'tbody tr' ).forEach( function ( tr ) {\n\t\t\ttr.querySelector( '.ax-emoji-demo__by' ).textContent = drawnBy( tr.querySelector( '.ax-emoji-demo__glyph' ) );\n\t\t} );\n\n\t\t// The front end prints the adapter's settings as JSON, as the adapter itself reads them.\n\t\tvar config = null;\n\t\tvar configNode = document.getElementById( 'axismundi-emoji-unicode-config' );\n\t\ttry {\n\t\t\tconfig = configNode ? JSON.parse( configNode.textContent ) : null;\n\t\t} catch ( e ) {\n\t\t\tconfig = null;\n\t\t}\n\t\tvar api = window.axismundiEmojiUnicode || null;\n\t\tvar decisions = api ? api.decisions() : {};\n\t\tvar used = Object.keys( decisions ).filter( function ( id ) {\n\t\t\treturn decisions[ id ];\n\t\t} );\n\t\tvar dl = document.createElement( 'dl' );\n\t\t[\n\t\t\trow( 'Axismundi rendering mode', config ? config.mode : 'WordPress fallback only (the plugin adds nothing to this page)' ),\n\t\t\trow( 'Noto Color Emoji used for', config ? ( used.length ? used.join( ', ' ) : 'nothing — this browser draws every profile itself' ) : '—' ),\n\t\t\trow( 'WordPress image fallback', document.getElementById( 'wp-emoji-settings' ) ? 'loaded' : 'switched off in Emojis › Settings' ),\n\t\t\trow( 'WordPress support tests', coreSupports() )\n\t\t].forEach( function ( pair ) {\n\t\t\tdl.appendChild( pair[ 0 ] );\n\t\t\tdl.appendChild( pair[ 1 ] );\n\t\t} );\n\t\tvar status = document.getElementById( 'ax-emoji-demo-status' );\n\t\tstatus.replaceChildren( dl );\n\t}\n\n\tvar timer = 0;\n\tfunction schedule() {\n\t\tclearTimeout( timer );\n\t\ttimer = setTimeout( render, 300 );\n\t}\n\tnew MutationObserver( schedule ).observe( root.querySelector( 'tbody' ), { childList: true, subtree: true, attributes: true } );\n\twindow.addEventListener( 'load', function () {\n\t\tsetTimeout( render, 1500 );\n\t} );\n} )();\n</script>\n<!-- /wp:html -->\n\n<!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Try it</h2>\n<!-- /wp:heading -->\n\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li>Switch between the three rendering modes in <a href=\"{{SETTINGS_URL}}\">Emojis › Settings</a>, reload this page and compare the last column. <em>WordPress fallback only</em> shows what WordPress does without the plugin.</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Open <a href=\"{{EDIT_URL}}\">this page in the editor</a>, select some text, and choose <em>Emoji</em> from the toolbar's <em>More</em> menu. Unicode and custom emoji share one searchable picker.</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Copy any row: the flag or emoji is copied as text, because the font draws it without replacing it.</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list -->\nHTML;\n\n// The blueprint's landingPage opens this page by its slug.\n$page_id = wp_insert_post(\n\tarray(\n\t\t'post_title'   => 'Axismundi Emoji rendering demo',\n\t\t'post_name'    => 'emoji-demo',\n\t\t'post_type'    => 'page',\n\t\t'post_status'  => 'publish',\n\t\t'post_content' => $content,\n\t)\n);\n\nif ( $page_id && ! is_wp_error( $page_id ) ) {\n\twp_update_post(\n\t\tarray(\n\t\t\t'ID'           => $page_id,\n\t\t\t'post_content' => strtr(\n\t\t\t\t$content,\n\t\t\t\tarray(\n\t\t\t\t\t'{{SETTINGS_URL}}' => esc_url( admin_url( 'admin.php?page=axismundi-emoji-settings' ) ),\n\t\t\t\t\t'{{EDIT_URL}}'     => esc_url( admin_url( 'post.php?post=' . $page_id . '&action=edit' ) ),\n\t\t\t\t)\n\t\t\t),\n\t\t)\n\t);\n}\n"
        }
    ]
}
