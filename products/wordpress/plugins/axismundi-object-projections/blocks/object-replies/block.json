{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "axismundi/object-replies",
	"version": "0.1.0",
	"title": "Object Replies",
	"category": "theme",
	"icon": "format-chat",
	"description": "The public reply thread of the ActivityStreams Object being rendered, including replies received from other servers.",
	"textdomain": "axismundi-object-projections",
	"attributes": {
		"perPage": { "type": "number", "default": 20 }
	},
	"example": { "viewportWidth": 500 },
	"supports": {
		"anchor": true,
		"html": false,
		"align": [ "wide", "full" ],
		"color": { "text": true, "background": true, "link": true },
		"spacing": { "margin": true, "padding": true, "blockGap": true },
		"typography": { "fontSize": true, "lineHeight": true }
	},
	"editorScript": "file:./edit.js",
	"style": [ "axismundi-op-object-view" ],
	"render": "file:./render.php"
}
