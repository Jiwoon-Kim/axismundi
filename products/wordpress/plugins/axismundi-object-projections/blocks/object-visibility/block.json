{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "axismundi/object-visibility",
	"version": "0.1.0",
	"title": "Object Visibility",
	"category": "theme",
	"icon": "visibility",
	"description": "Who the ActivityStreams Object being rendered was addressed to. Its audience, not where it was posted — being in a community is a separate fact.",
	"textdomain": "axismundi-object-projections",
	"attributes": {
		"showLabel": { "type": "boolean", "default": false }
	},
	"example": { "viewportWidth": 500 },
	"supports": {
		"anchor": true,
		"html": false,
		"color": {
			"gradients": false,
			"__experimentalDefaultControls": { "text": true }
		},
		"spacing": { "margin": true, "padding": true },
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalDefaultControls": { "fontSize": true }
		},
		"interactivity": { "clientNavigation": true }
	},
	"editorScript": "file:./edit.js",
	"style": "file:./style.css",
	"render": "file:./render.php"
}
